       <!-- Export Modal -->\n        \n        \n        <!-- Start About Area -->\n<section class="about-area ">\n    <div class="container">\n        <div class="row align-items-center justify-content-center" style="padding:30px">\n            <div class="col-lg-5 col-md-6 about-left">\n                <img class="img-fluid" src="/static/img/avatar.jpg" alt="RapidDNS Database Statistics">\n            </div>\n            <div class="offset-lg-1 col-lg-6 offset-md-0 col-md-12 about-right">\n                <h1>\n                    Rapiddns has <b>8 billion</b> DNS data and supports 4 DNS types\n                </h1>\n                <div class="wow fadeIn" data-wow-duration="1s">\n                    <p>\n                        Rapiddns currently has more than 8 billion DNS resolution data, supporting A, CNAME, AAAA, MX types. A records 5.1 billion, CNAME records 985 million, AAAA records 1.7 billion and MX records 1.1 billion. Can query the domain name of the same IP website (support IPv6). You can also\n                        query subdomain information.\n                    </p>\n                    <p>\n\n                    </p>\n                </div>\n\n            </div>\n        </div>\n    </div>\n</section>\n<!-- End About Area --> <!-- Start Footer Area -->\n<footer class="footer-area">\n    <div class="container">\n        <div class="footer-bottom row align-items-center" style="padding:30px;">\n            <div class="col-lg-8 col-md-12">\n                <p class="footer-text m-0">\n                    Copyright &copy;\n                    <script>\n                        document.write(new Date().getFullYear());\n                    </script> - <a href="/">ULTIMATE DOMAIN NETWORK ONLINE LIMITED</a> All rights reserved \p <a href="/tos">Terms of Service</a>\n                </p>\n                <p class="footer-text m-0 mt-1">\n                    <i class="fas fa-envelope mr-1"></i> Support: <a href="/cdn-cgi/l/email-protection#b9caccc9c9d6cbc