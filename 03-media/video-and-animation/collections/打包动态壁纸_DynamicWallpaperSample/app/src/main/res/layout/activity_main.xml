<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        tools:context=".MainActivity">
    <SurfaceView android:layout_width="0dp"
                 android:layout_height="0dp" android:id="@+id/surfaceVideo"
                 app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"
                 app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">

    </SurfaceView>
    <View
            android:layout_width="0dp"
            android:layout_height="50dp" android:id="@+id/view" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="16dp"
            android:foreground="?android:attr/listChoiceIndicatorSingle"
            android:foregroundGravity="left|center_vertical" android:foregroundTint="#FFFFFF"
            android:onClick="btnPressed">

    </View>
    <TextView
            android:text="@string/setWallpaperButtonLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:id="@+id/textView" android:textColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="@+id/view"
            app:layout_constraintBottom_toBottomOf="@+id/view"
            app:layout_constraintEnd_toEndOf="@+id/view" android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@+id/view"/>

</androidx.constraintlayout.widget.ConstraintLayout>