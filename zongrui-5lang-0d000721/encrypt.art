; Arturo — 5-layer encrypt of 0d000721
; L1 reverse → L2 XOR 0x5A → L3 hex → L4 base64 → L5 reverse

plain: "0d000721"
l1: reverse plain

xorBytes: []
loop split l1 'ch [
    'b: xor (to :integer first to [:char] ch) 0x5A
    'xorBytes: xorBytes ++ @[b]
]

hexDigits: split "0123456789abcdef"
l3: ""
loop xorBytes 'b [
    'l3: l3 ++ (get hexDigits (shr b 4)) ++ (get hexDigits (and b 0x0F))
]

l4: encode l3 'base64
l5: reverse l4
print l5
