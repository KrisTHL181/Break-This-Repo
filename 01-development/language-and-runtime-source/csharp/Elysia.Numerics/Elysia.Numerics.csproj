<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Elysia.Numerics

    TargetFramework / LangVersion / Nullable / Analyzers are inherited from the
    Directory.Build.props one level up. Deliberately: nothing here names a package,
    a feed, or a version. This project has exactly one dependency, and it ships with
    the runtime — the static abstract members of System.Numerics.INumber{T}.
  -->
  <PropertyGroup>
    <AssemblyName>Elysia.Numerics</AssemblyName>
    <RootNamespace>Elysia.Numerics</RootNamespace>
  </PropertyGroup>

</Project>
