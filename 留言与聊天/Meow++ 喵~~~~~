//请谨慎吸猫编码

//Meow++ 是一门 强类型、高冷、非确定性 的系统级编程语言
//它完美继承了 C++ 的强大与复杂，同时注入了猫科动物的灵魂
//虽然学习曲线陡峭（就像爬上衣柜顶），但一旦掌握，你将体验到与机器（和猫）深度共鸣的极致优雅


叼来 <喵呜库>叼来 <毛线球库>
领地 电子猫 {
禁地:
喵td的毛线球 名字;
喵 饥饿;
喵 快乐;
喵 能量;
真喵 活着;
敞开:
电子猫(喵td的毛线球 猫名) {
名字 按 猫名;
饥饿 按 50;
快乐 按 50;
能量 按 100;
活着 按 真;
}
真喵 还活着() {
喵呜! 活着;
}
呼... 滴答() {
饥饿 按 饥饿 + 10;
快乐 按 快乐 - 5;
能量 按 能量 - 5;
咕噜 (饥饿 > 100 或者随便 快乐 < 0 或者随便 能量 < 0) {
活着 按 假;
}
}
呼... 显示状态() {
嚎叫 << "=== " << 名字 << " 的状态 ===" << 换行;
嚎叫 << "饱食度: ";
喵撕 (喵 i 按 0; i < 10; i 蹭蹭) {
咕噜 (i < 饥饿 / 10) {
嚎叫 << "[空]";
} 咕噜噜 {
嚎叫 << "[满]";
}
}
嚎叫 << " (" << 饥饿 << "/100)" << 换行;
嚎叫 << "开心值: ";
喵撕 (喵 i 按 0; i < 10; i 蹭蹭) {
咕噜 (i < 快乐 / 10) {
嚎叫 << "[呼]";
} 咕噜噜 {
嚎叫 << "[噜]";
}
}
嚎叫 << " (" << 快乐 << "/100)" << 换行;
嚎叫 << "精力值: ";
喵撕 (喵 i 按 0; i < 10; i 蹭蹭) {
咕噜 (i < 能量 / 10) {
嚎叫 << "[Z]";
} 咕噜噜 {
嚎叫 << "[!]";
}
}
嚎叫 << " (" << 能量 << "/100)" << 换行;
嚎叫 << "======================" << 换行;
}
呼... 喂食() {
咕噜 (饥饿 > 20) {
饥饿 按 饥饿 - 30;
快乐 按 快乐 + 5;
嚎叫 << 名字 << " 吧唧吧唧吃掉了猫粮... 喵~" << 换行;
} 咕噜噜 {
嚎叫 << 名字 << " 闻了闻，嫌弃地走开了。" << 换行;
}
}
呼... 玩耍() {
咕噜 (能量 > 30) {
快乐 按 快乐 + 25;
能量 按 能量 - 30;
饥饿 按 饥饿 + 15;
嚎叫 << 名字 << " 疯狂扑咬逗猫棒！开心！" << 换行;
} 咕噜噜 {
嚎叫 << 名字 << " 累得瘫倒在地，不想动。" << 换行;
}
}
呼... 睡觉() {
能量 按 能量 + 50;
饥饿 按 饥饿 + 10;
嚎叫 << 名字 << " 蜷缩成一个毛线球，呼噜噜...呼噜噜..." << 换行;
}
呼... 抚摸() {
快乐 按 快乐 + 10;
嚎叫 << 名字 << " 眯起眼睛，发出了巨大的引擎声。" << 换行;
}
};
喵 主函数() {
喵td的毛线球 输入名字;
嚎叫 << "给你的新电子猫起个名字吧: ";
嗅探 >> 输入名字;
电子猫 喵主子(输入名字);
喵 选择 按 0;
嚎叫 << "欢迎使用 Meow++ 电子猫宠物系统 v1.0" << 换行;
喵撕 (喵主子.还活着()) {
喵主子.显示状态();
嚎叫 << "你要做什么？" << 换行;
嚎叫 << "1. 投喂猫粮" << 换行;
嚎叫 << "2. 玩耍逗猫棒" << 换行;
嚎叫 << "3. 哄它睡觉" << 换行;
嚎叫 << "4. 摸摸头" << 换行;
嚎叫 << "5. 离家出走 (退出)" << 换行;
嚎叫 << "请选择 (1-5): ";
嗅探 >> 选择;
挑选 (选择) {
爪子 1:
喵主子.喂食();
哈!;
爪子 2:
喵主子.玩耍();
哈!;
爪子 3:
喵主子.睡觉();
哈!;
爪子 4:
喵主子.抚摸();
哈!;
爪子 5:
嚎叫 << "你打开了大门，" << 输入名字 << " 头也不回地溜了出去..." << 换行;
喵呜! 0;
随便:
嚎叫 << "喵主子歪着头看着你，似乎没听懂。" << 换行;
哈!;
}
喵主子.滴答();
}
嚎叫 << 输入名字 << " 因为照顾不周，连夜扛着猫砂盆离家出走了。" << 换行;
嚎叫 << "游戏结束。" << 换行;
喵呜! 0;
}
