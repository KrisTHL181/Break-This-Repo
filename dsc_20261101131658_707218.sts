l-scale=1.0, viewport-fit=cover">\n<meta name="color-scheme" content="dark light">\n<meta name="theme-color" content="#0e1117">\n<title>引き出し ｜ Drawer UI</title>\n<style>\n  :root{\n    --bg:#0e1117;\n    --g1:#1a2334;\n    --g2:#241c36;\n    --panel:#161b24;\n    --panel-2:#1d2431;\n    --line:#2a3344;\n    --text:#e9eef6;\n    --muted:#8695ad;\n    --accent:#4f9cff;\n    --accent-2:#8b6cff;\n    --ok:#2fd18a;\n    --wood:#3d2d23;\n    --wood-dark:#241a14;\n    --wood-light:#54402f;\n    --handle:#d0a771;\n    --handle-dk:#a67c4c;\n    --shadow:0 18px 40px rgba(0,0,0,.45);\n    --ease:cubic-bezier(.22,1,.36,1);\n    --r:18px;\n  }\n  html[data-theme="light"]{\n    --bg:#f2f5fa;\n    --g1:#dde7f7;\n    --g2:#ece4f8;\n    --panel:#ffffff;\n    --panel-2:#f4f7fc;\n    --line:#dde4ef;\n    --text:#131922;\n    --muted:#5f6d82;\n    --shadow:0 18px 40px rgba(30,45,70,.16);\n  }\n  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}\n  html,body{height:100%;}\n  body{\n    margin:0;\n    font-family:"Noto Sans JP","Hiragino Sans","Yu Gothic",system-ui,-apple-system,sans-serif;\n    color:var(--text);\n    background:\n      radial-gradient(1100px 560px at 8% -12%, var(--g1) 0%, transparent 62%),\n      radial-gradient(900px 520px at 108% 6%, var(--g2) 0%, transparent 58%),\n      var(--bg);\n    min-height:100dvh;\n    overflow-x:hidden;\n    -webkit-font-smoothing:antialiased;\n    transition:background .35s ease,color .35s ease;\n  }\n\n  /* ============ トップバー ============ */\n  .topbar{\n    position:sticky;top:0;z-index:40;\n    display:flex;align-items:center;gap:10px;\n    padding:13px 15px;\n    background:color-mix(in srgb,var(--bg) 78%,transparent);\n    backdrop-filter:blur(16px) saturate(150%);\n    -webkit-backdrop-filter:blur(16px) saturate(150%);\n    border-bottom:1px solid color-mix(in srgb,var(--line) 70%,transparent);\n  }\n  .icon-btn{\n    width:42px;height:42px;flex:0 0 auto;display:grid;place-items:center;\n    border-radius:13px;border:1px solid var(--line);\n    background:linear-gradient(180deg,var(--panel-2),var(--panel));\n    color:var(--text);cursor:pointer;padding:0;\n    transition:transform .18s var(--ease),background .18s,border-color .18s;\n  }\n  .icon-btn:active{transform:scale(.9);}\n  .icon-btn svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;}\n  .brand{display:flex;flex-direction:column;line-height:1.18;margin-left:2px;flex:1;min-width:0;}\n  .brand b{font-size:15.5px;letter-spacing:.02em;}\n  .brand span{font-size:10.5px;color:var(--muted);letter-spacing:.16em;text-transform:uppercase;}\n\n  /* ============ バックドロップ ============ */\n  .backdrop{\n    position:fixed;inset:0;z-index:50;\n    background:rgba(6,9,14,.58);\n    backdrop-filter:blur(3px);\n    -webkit-backdrop-filter:blur(3px);\n    opacity:0;visibility:hidden;\n    transition:opacity .34s var(--ease),visibility .34s;\n  }\n  .backdrop.show{opacity:1;visibility:visible;}\n\n  /* ============ サイドドロワー ============ */\n  .drawer-panel{\n    position:fixed;top:0;bottom:0;z-index:60;\n    width:min(78vw,305px);\n    display:flex;flex-direction:column;\n    background:linear-gradient(180deg,var(--panel-2),var(--panel));\n    box-shadow:var(--shadow);\n    transition:transform .38s var(--ease);\n    will-change:transform;\n    padding-top:env(safe-area-inset-top);\n    overflow-y:auto;\n  }\n  .drawer-panel.left{left:0;border-radius:0 var(--r) var(--r) 0;transform:translateX(-102%);border-right:1px solid var(--line);}\n  .drawer-panel.right{right:0;border-radius:var(--r) 0 0 var(--r);transform:translateX(102%);border-left:1px solid var(--line);}\n  .drawer-panel.left.open,.drawer-panel.right.open{transform:translateX(0);}\n\n  .panel-head{\n    display:flex;align-items:center;justify-content:space-between;\n    padding:16px 16px 12px;\n    border-bottom:1px solid var(--line);\n  }\n  .panel-head h3{margin:0;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:600;}\n  .panel-close{\n    width:32px;height:32px;border-radius:10px;border:1px solid var(--line);\n    background:transparent;color:var(--muted);cursor:pointer;display:grid;place-items:center;padding:0;\n    transition:background .18s,color .18s,transform .18s var(--ease);\n  }\n  .panel-close:active{transform:scale(.9);background:var(--panel-2);}\n  .panel-close svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;}\n\n  /* ナビ項目 */\n  .nav-list{list-style:none;margin:0;padding:10px;display:flex;flex-direction:column;gap:4px;}\n  .nav-item{\n    display:flex;align-items:center;gap:13px;\n    padding:13px 13px;border-radius:13px;cursor:pointer;\n    color:var(--text);text-decoration:none;font-size:14.5px;\n    border:1px solid transparent;\n    transition:background .2s,border-color .2s,transform .16s var(--ease);\n  }\n  .nav-item:active{transform:scale(.98);}\n  .nav-item.active{\n    background:linear-gradient(90deg,color-mix(in srgb,var(--accent) 22%,transparent),transparent 85%);\n    border-color:color-mix(in srgb,var(--accent) 38%,transparent);\n  }\n  .nav-ico{\n    width:34px;height:34px;flex:0 0 auto;border-radius:10px;display:grid;place-items:center;\n    background:var(--panel-2);border:1px solid var(--line);font-size:16px;\n  }\n  .nav-item.active .nav-ico{background:color-mix(in srgb,var(--accent) 26%,transparent);border-color:transparent;}\n  .nav-txt{display:flex;flex-direction:column;line-height:1.25;}\n  .nav-txt b{font-weight:600;font-size:14.5px;}\n  .nav-txt small{font-size:11px;color:var(--muted);}\n\n  /* 設定行 */\n  .set-list{list-style:none;margin:0;padding:10px;display:flex;flex-direction:column;gap:2px;}\n  .set-row{\n    display:flex;align-items:center;gap:12px;padding:14px 12px;border-radius:13px;\n    transition:background .2s;\n  }\n  .set-row:active{background:var(--panel-2);}\n  .set-txt{flex:1;display:flex;flex-direction:column;line-height:1.3;}\n  .set-txt b{font-size:14px;font-weight:600;}\n  .set-txt small{font-size:11px;color:var(--muted);margin-top:2px;}\n  .switch{\n    position:relative;width:48px;height:28px;flex:0 0 auto;border-radius:99px;\n    background:var(--line);border:none;cursor:pointer;padding:0;\n    transition:background .26s var(--ease);\n  }\n  .switch::after{\n    content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;\n    background:#fff;box-shadow:0 2px 6px rgba(0,0,0,.3);\n    transition:transform .26s var(--ease);\n  }\n  .switch[aria-checked="true"]{background:linear-gradient(90deg,var(--accent),var(--accent-2));}\n  .switch[aria-checked="true"]::after{transform:translateX(20px);}\n\n  /* ============ メイン ============ */\n  main{padding:16px 15px 64px;max-width:720px;margin:0 auto;}\n  .hero{\n    padding:18px;border-radius:var(--r);\n    background:linear-gradient(150deg,color-mix(in srgb,var(--accent) 16%,var(--panel)),var(--panel) 62%);\n    border:1px solid var(--line);\n    margin-bottom:18px;\n  }\n  .hero h1{margin:0 0 6px;font-size:20px;letter-spacing:.01em;}\n  .hero p{margin:0;font-size:13px;color:var(--muted);line-height:1.65;}\n\n  /* ============ 木製キャビネット ============ */\n  .cabinet{\n    border-radius:20px;\n    padding:14px;\n    background:linear-gradient(180deg,var(--wood-light),var(--wood) 22%,var(--wood-dark) 100%);\n    border:1px solid rgba(0,0,0,.42);\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.14),\n      inset 0 -2px 0 rgba(0,0,0,.32),\n      0 22px 46px rgba(0,0,0,.42);\n    position:relative;\n    background-blend-mode:overlay;\n  }\n  .cabinet::before{\n    content:"";position:absolute;inset:0;border-radius:20px;pointer-events:none;\n    background:repeating-linear-gradient(92deg,rgba(255,255,255,.032) 0 2px,transparent 2px 7px),\n               repeating-linear-gradient(88deg,rgba(0,0,0,.06) 0 1px,transparent 1px 9px);\n    opacity:.9;\n  }\n  .cabinet-head{\n    display:flex;align-items:baseline;justify-content:space-between;\n    padding:4px 6px 12px;position:relative;\n  }\n  .cabinet-head h2{margin:0;font-size:15px;color:#f0dfcb;letter-spacing:.08em;}\n  .cabinet-head .badge{\n    font-size:10.5px;padding:3px 9px;border-radius:99px;letter-spacing:.1em;\n    color:#f5e6d3;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.16);\n  }\n\n  .drawer-item{\n    position:relative;margin-bottom:9px;border-radius:12px;\n    transition:margin .4s var(--ease);\n  }\n  .drawer-item:last-child{margin-bottom:0;}\n\n  .drawer-face{\n    width:100%;display:flex;align-items:center;gap:12px;\n    padding:15px 14px;cursor:pointer;text-align:left;\n    border-radius:12px;border:1px solid rgba(0,0,0,.4);\n    background:linear-gradient(180deg,var(--wood-light),var(--wood) 55%,var(--wood-dark));\n    color:#f3e5d4;font-family:inherit;\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.2),\n      inset 0 -3px 0 rgba(0,0,0,.28),\n      0 6px 12px rgba(0,0,0,.35);\n    transition:transform .3s var(--ease),box-shadow .3s var(--ease),filter .25s;\n    position:relative;z-index:2;\n  }\n  .drawer-face:active{transform:translateY(1px) scale(.995);filter:brightness(1.06);}\n  .drawer-item.open .drawer-face{\n    border-radius:12px 12px 4px 4px;\n    box-shadow:\n      inset 0 1px 0 rgba(255,255,255,.24),\n      0 10px 20px rgba(0,0,0,.42);\n  }\n\n  /* 取っ手 */\n  .handle{\n    width:46px;height:11px;flex:0 0 auto;border-radius:99px;\n    background:linear-gradient(180deg,var(--handle),var(--handle-dk));\n    box-shadow:inset 0 1px 0 rgba(255,255,255,.55),0 2px 4px rgba(0,0,0,.45);\n    position:relative;\n  }\n  .handle::before,.handle::after{\n    content:"";position:absolute;top:50%;transform:translateY(-50%);\n    width:6px;height:6px;border-radius:50%;\n    background:radial-gradient(circle at 35% 30%,#e8cfa9,#8a6537);\n    box-shadow:inset 0 -1px 1px rgba(0,0,0,.4);\n  }\n  .handle::before{left:-3px;}\n  .handle::after{right:-3px;}\n\n  .drawer-label{flex:1;display:flex;flex-direction:column;line-height:1.25;min-width:0;}\n  .drawer-label b{font-size:14.5px;letter-spacing:.02em;}\n  .drawer-label small{font-size:10.5px;color:rgba(243,229,212,.62);letter-spacing:.09em;text-transform:uppercase;margin-top:2px;}\n\n  .drawer-chev{\n    width:26px;height:26px;flex:0 0 auto;display:grid;place-items:center;border-radius:8px;\n    background:rgba(0,0,0,.22);transition:transform .38s var(--ease);\n  }\n  .drawer-chev svg{width:14px;height:14px;fill:none;stroke:#e8d7c2;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;}\n  .drawer-item.open .drawer-chev{transform:rotate(180deg);}\n\n  .drawer-body{\n    overflow:hidden;max-height:0;\n    transition:max-height .45s var(--ease);\n    border-radius:0 0 12px 12px;\n    background:linear-gradient(180deg,#f6efe4,#e8dccb);\n    box-shadow:inset 0 8px 14px rgba(0,0,0,.24);\n  }\n  .drawer-inner{\n    padding:15px 16px 17px;font-size:13px;line-height:1.75;color:#3b2f24;\n  }\n  .drawer-inner p{margin:0 0 9px;}\n  .drawer-inner p:last-child{margin-bottom:0;}\n  .drawer-inner ul{margin:0;padding-left:19px;}\n  .drawer-inner li{margin-bottom:6px;}\n  .chip{\n    display:inline-block;font-size:11px;padding:3px 9px;border-radius:99px;margin:0 5px 6px 0;\n    background:rgba(59,47,36,.09);border:1px solid rgba(59,47,36,.16);color:#4a3b2c;\n  }\n\n  .hint{\n    margin-top:18px;padding:13px 15px;border-radius:14px;\n    border:1px dashed var(--line);background:color-mix(in srgb,var(--panel) 70%,transparent);\n    font-size:12.5px;color:var(--muted);line-height:1.7;\n  }\n  .hint b{color:var(--text);}\n\n  .toast{\n    position:fixed;left:50%;bottom:26px;transform:translate(-50%,20px);\n    z-index:90;padding:11px 18px;border-radius:99px;\n    background:rgba(22,27,36,.95);border:1px solid var(--line);\n    color:var(--text);font-size:13px;opacity:0;pointer-events:none;\n    transition:opacity .28s var(--ease),transform .28s var(--ease);\n    box-shadow:var(--shadow);backdrop-filter:blur(10px);\n  }\n  .toast.show{opacity:1;transform:translate(-50%,0);}\n\n  @media (prefers-reduced-motion: reduce){\n    *{transition-duration:.01ms !important;animation-duration:.01ms !important;}\n  }\n</style>\n</head>\n<body>\n\n<header class="topbar">\n  <button class="icon-btn" id="btnLeft" aria-label="メニューを開く" aria-expanded="false">\n    <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h11M4 17h16"/></svg>\n  </button>\n  <div class="brand">\n    <b>引き出し UI</b>\n    <span>Drawer Demo</span>\n  </div>\n  <button class="icon-btn" id="btnRight" aria-label="設定を開く" aria-expanded="false">\n    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6"/></svg>\n  </button>\n</header>\n\n<div class="backdrop" id="backdrop"></div>\n\n<!-- 左ドロワー：ナビゲーション -->\n<nav class="drawer-panel left" id="panelLeft" aria-hidden="true">\n  <div class="panel-head">\n    <h3>メニュー</h3>\n    <button class="panel-close" data-close aria-label="閉じる">\n      <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>\n    </button>\n  </div>\n  <ul class="nav-list">\n    <li><a class="nav-item active" href="#" data-nav>\n      <span class="nav-ico">🏠</span>\n      <span class="nav-txt"><b>ホーム</b><small>Home</small></span>\n    </a></li>\n    <li><a class="nav-item" href="#" data-nav>\n      <span class="nav-ico">🗂️</span>\n      <span class="nav-txt"><b>引き出し一覧</b><small>Drawers</small></span>\n    </a></li>\n    <li><a class="nav-item" href="#" data-nav>\n      <span class="nav-ico">📊</span>\n      <span class="nav-txt"><b>統計</b><small>Analytics</small></span>\n    </a></li>\n    <li><a class="nav-item" href="#" data-nav>\n      <span class="nav-ico">🔔</span>\n      <span class="nav-txt"><b>通知</b><small>Notifications</small></span>\n    </a></li>\n    <li><a class="nav-item" href="#" data-nav>\n      <span class="nav-ico">⚙️</span>\n      <span class="nav-txt"><b>設定</b><small>Settings</small></span>\n    </a></li>\n  </ul>\n</nav>\n\n<!-- 右ドロワー：設定 -->\n<aside class="drawer-panel right" id="panelRight" aria-hidden="true">\n  <div class="panel-head">\n    <h3>設定</h3>\n    <button class="panel-close" data-close aria-label="閉じる">\n      <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>\n    </button>\n  </div>\n  <ul class="set-list">\n    <li class="set-row">\n      <span class="set-txt"><b>ライトテーマ</b><small>画面の配色を切り替え</small></span>\n      <button class="switch" role="switch" aria-checked="false" id="swTheme" aria-label="ライトテーマ"></button>\n    </li>\n    <li class="set-row">\n      <span class="set-txt"><b>サウンド</b><small>操作音を鳴らす</small></span>\n      <button class="switch" role="switch" aria-checked="true" id="swSound" aria-label="サウンド"></button>\n    </li>\n    <li class="set-row">\n      <span class="set-txt"><b>自動展開</b><small>1つ開くと他を閉じる</small></span>\n      <button class="switch" role="switch" aria-checked="true" id="swAuto" aria-label="自動展開"></button>\n    </li>\n    <li class="set-row">\n      <span class="set-txt"><b>すべて閉じる</b><small>開いている引き出しを戻す</small></span>\n      <button class="icon-btn" id="btnCloseAll" aria-label="すべて閉じる" style="width:38px;height:38px;">\n        <svg viewBox="0 0 24 24"><path d="M4 9h16M4 15h16"/></svg>\n      </button>\n    </li>\n  </ul>\n</aside>\n\n<main>\n  <section class="hero">\n    <h1>引き出し式インターフェース</h1>\n    <p>左のメニューと右の設定はサイドドロワー、下の木箱は本物の「引き出し」です。取っ手を押すと手前に引き出され、中身が現れます。</p>\n  </section>\n\n  <section class="cabinet">\n    <div class="cabinet-head">\n      <h2>木製キャビネット</h2>\n      <span class="badge">4 段</span>\n    </div>\n\n    <article class="drawer-item">\n      <button class="drawer-face" aria-expanded="false">\n        <span class="handle" aria-hidden="true"></span>\n        <span class="drawer-label"><b>書類</b><small>Documents</small></span>\n        <span class="drawer-chev"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></span>\n      </button>\n      <div class="drawer-body">\n        <div class="drawer-inner">\n          <p>契約書・保証書・領収書の三点セット。年度ごとに封筒で仕切ってあります。</p>\n          <span class="chip">2026 年度</span><span class="chip">要返却</span><span class="chip">原本</span>\n        </div>\n      </div>\n    </article>\n\n    <article class="drawer-item">\n      <button class="drawer-face" aria-expanded="false">\n        <span class="handle" aria-hidden="true"></span>\n        <span class="drawer-label"><b>工具</b><small>Tools</small></span>\n        <span class="drawer-chev"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></span>\n      </button>\n      <div class="drawer-body">\n        <div class="drawer-inner">\n          <ul>\n            <li>ドライバー（＋・− 各 3 サイズ）</li>\n            <li>メジャー 5m、六角レンチセット</li>\n            <li>結束バンド、両面テープ、養生テープ</li>\n          </ul>\n        </div>\n      </div>\n    </article>\n\n    <article class="drawer-item">\n      <button class="drawer-face" aria-expanded="false">\n        <span class="handle" aria-hidden="true"></span>\n        <span class="drawer-label"><b>ケーブル</b><small>Cables</small></span>\n        <span class="drawer-chev"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></span>\n      </button>\n      <div class="drawer-body">\n        <div class="drawer-inner">\n          <p>Type-C・Lightning・HDMI・LAN をそれぞれ小分け袋に入れて結束しています。</p>\n          <span class="chip">Type-C ×4</span><span class="chip">HDMI 2.1</span><span class="chip">LAN Cat6</span>\n        </div>\n      </div>\n    </article>\n\n    <article class="drawer-item">\n      <button class="drawer-face" aria-expanded="false">\n        <span class="handle" aria-hidden="true"></span>\n        <span class="drawer-label"><b>その他</b><small>Misc</small></span>\n        <span class="drawer-chev"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></span>\n      </button>\n      <div class="drawer-body">\n        <div class="drawer-inner">\n          <p>予備の電池、クリップ、付箋、使わなくなった小物の一時避難所。</p>\n        </div>\n      </div>\n    </article>\n  </section>\n\n  <div class="hint">\n    <b>使い方</b><br>\n    取っ手をタップで開閉 ・ 外側をタップでサイドドロワーが閉じます ・ 設定で「すべて閉じる」も使えます\n  </div>\n</main>\n\n<div class="toast" id="toast"></div>\n\n<script>\n(function(){\n  "use strict";\n\n  var backdrop = document.getElementById('backdrop');\n  var panelL   = document.getElementById('panelLeft');\n  var panelR   = document.getElementById('panelRight');\n  var btnL     = document.getElementById('btnLeft');\n  var btnR     = document.getElementById('btnRight');\n  var toastEl  = document.getElementById('toast');\n  var soundOn  = true;\n  var autoSolo = true;\n\n  /* --- トースト --- */\n  var toastTimer = null;\n  function toast(msg){\n    toastEl.textContent = msg;\n    toastEl.classList.add('show');\n    clearTimeout(toastTimer);\n    toastTimer = setTimeout(function(){ toastEl.classList.remove('show'); }, 1600);\n  }\n\n  /* --- 簡易操作音 --- */\n  var actx = null;\n  function beep(freq){\n    if(!soundOn) return;\n    try{\n      if(!actx) actx = new (window.AudioContext \p\p window.webkitAudioContext)();\n      var o = actx.createOscillator(), g = actx.createGain();\n      o.type = 'sine';\n      o.frequency.value = freq \p\p 660;\n      g.gain.setValueAtTime(0.0001, actx.currentTime);\n      g.gain.exponentialRampToValueAtTime(0.06, actx.currentTime + 0.01);\n      g.gain.exponentialRampToValueAtTime(0.0001, actx.currentTime + 0.14);\n      o.connect(g); g.connect(actx.destination);\n      o.start(); o.stop(actx.currentTime + 0.15);\n    }catch(e){}\n  }\n\n  /* --- サイドドロワー開閉 --- */\n  function openSide(){\n    backdrop.classList.add('show');\n    document.body.style.overflow = 'hidden';\n  }\n  function closeAllSides(){\n    panelL.classList.remove('open');\n    panelR.classList.remove('open');\n    backdrop.classList.remove('show');\n    document.body.style.overflow = '';\n    btnL.setAttribute('aria-expanded','false');\n    btnR.setAttribute('aria-expanded','false');\n    panelL.setAttribute('aria-hidden','true');\n    panelR.setAttribute('aria-hidden','true');\n  }\n  btnL.addEventListener('click', function(){\n    var willOpen = !panelL.classList.contains('open');\n    closeAllSides();\n    if(willOpen){\n      panelL.classList.add('open');\n      btnL.setAttribute('aria-expanded','true');\n      panelL.setAttribute('aria-hidden','false');\n      openSide();\n      beep(520);\n    }\n  });\n  btnR.addEventListener('click', function(){\n    var willOpen = !panelR.classList.contains('open');\n    closeAllSides();\n    if(willOpen){\n      panelR.classList.add('open');\n      btnR.setAttribute('aria-expanded','true');\n      panelR.setAttribute('aria-hidden','false');\n      openSide();\n      beep(520);\n    }\n  });\n  backdrop.addEventListener('click', closeAllSides);\n  Array.prototype.forEach.call(document.querySelectorAll('[data-close]'), function(b){\n    b.addEventListener('click', function(){ closeAllSides(); });\n  });\n  document.addEventListener('keydown', function(e){\n    if(e.key === 'Escape') closeAllSides();\n  });\n\n  /* --- ナビ項目 --- */\n  Array.prototype.forEach.call(document.querySelectorAll('[data-nav]'), function(a){\n    a.addEventListener('click', function(e){\n      e.preventDefault();\n      Array.prototype.forEach.call(document.querySelectorAll('[data-nav]'), function(x){\n        x.classList.remove('active');\n      });\n      a.classList.add('active');\n      beep(700);\n      toast(a.querySelector('b').textContent + ' を選択しました');\n      setTimeout(closeAllSides, 240);\n    });\n  });\n\n  /* --- キャビネットの引き出し --- */\n  var drawers = Array.prototype.slice.call(document.querySelectorAll('.drawer-item'));\n\n  function setOpen(item, open){\n    var face = item.querySelector('.drawer-face');\n    var body = item.querySelector('.drawer-body');\n    item.classList.toggle('open', open);\n    face.setAttribute('aria-expanded', open ? 'true' : 'false');\n    body.style.maxHeight = open ? (body.scrollHeight + 'px') : '0px';\n  }\n\n  drawers.forEach(function(item, idx){\n    var face = item.querySelector('.drawer-face');\n    face.addEventListener('click', function(){\n      var willOpen = !item.classList.contains('open');\n      if(willOpen && autoSolo){\n        drawers.forEach(function(o){ if(o !== item) setOpen(o, false); });\n      }\n      setOpen(item, willOpen);\n      beep(willOpen ? 440 + idx * 60 : 300);\n      if(willOpen){\n        toast(item.querySelector('.drawer-label b').textContent + ' を開きました');\n      }\n    });\n  });\n\n  /* リサイズ時に開いている引き出しの高さを追従 */\n  window.addEventListener('resize', function(){\n    drawers.forEach(function(item){\n      if(item.classList.contains('open')){\n        var body = item.querySelector('.drawer-body');\n        body.style.maxHeight = body.scrollHeight + 'px';\n      }\n    });\n  });\n\n  /* --- スイッチ --- */\n  function bindSwitch(el, onChange){\n    el.addEventListener('click', function(){\n      var on = el.getAttribute('aria-checked') === 'true';\n      el.setAttribute('aria-checked', on ? 'false' : 'true');\n      beep(on ? 340 : 620);\n      if(onChange) onChange(!on);\n    });\n  }\n\n  var swTheme = document.getElementById('swTheme');\n  bindSwitch(swTheme, function(on){\n    document.documentElement.setAttribute('data-theme', on ? 'light' : 'dark');\n    var meta = document.querySelector('meta[name="theme-color"]');\n    if(meta) meta.setAttribute('content', on ? '#f2f5fa' : '#0e1117');\n    toast(on ? 'ライトテーマに切り替えました' : 'ダークテーマに戻しました');\n  });\n\n  bindSwitch(document.getElementById('swSound'), function(on){\n    soundOn = on;\n    toast(on ? 'サウンドをオン' : 'サウンドをオフ');\n  });\n\n  bindSwitch(document.getElementById('swAuto'), function(on){\n    autoSolo = on;\n    toast(on ? '自動展開オン' : '自動展開オフ');\n  });\n\n  document.getElementById('btnCloseAll').addEventListener('click', function(){\n    drawers.forEach(function(o){ setOpen(o, false); });\n    beep(300);\n    toast('すべての引き出しを閉じました');\n  });\n\n  /* 初期状態：1段目を開いておく */\n  window.addEventListener('load', function(){\n    setTimeout(function(){\n      if(drawers[0]) setOpen(drawers[0], true);\n    }, 420);\n  });\n})();\n</script>\n</body>\n</html>\n\n\nNow I have the full file. Let me translate all Japanese to Chinese. I'll write the whole translated file.\n\nLet me do the translation carefully:\n\n- `lang="ja"` → `lang="zh-CN"`\n- `<title>引き出し ｜ Drawer UI</title>` → `<title>抽屉式界面 ｜ Drawer UI</title>`\n- font-family: "Noto Sans JP","Hiragino Sans","Yu Gothic" → could add Chinese fonts: "Noto Sans SC","PingFang SC","Microsoft YaHei"\n- Comments translate\n- aria-labels translate\n- Text content translate\n\nLet me create the full Chinese version.\n\nTranslations:\n- トップバー → 顶栏\n- バックドロップ → 背景遮罩\n- サイドドロワー → 侧边抽屉\n- ナビ項目 → 导航项\n- 設定行 → 设置行\n- メイン → 主内容\n- 木製キャビネット → 木质收纳柜\n- 取っ手 → 把手\n- メニューを開く → 打开菜单\n- 設定を開く → 打开设置\n- 引き出し UI → 抽屉式界面\n- Drawer Demo → Drawer Demo (keep)\n- 左ドロワー：ナビゲーション → 左侧抽屉：导航\n- メニュー → 菜单\n- 閉じる → 关闭\n- ホーム/Home → 首页/Home\n- 引き出し一覧/Drawers → 抽屉一览/Drawers\n- 統計/Analytics → 统计/Analytics\n- 通知/Notifications → 通知/Notifications\n- 設定/Settings → 设置/Settings\n- 右ドロワー：設定 → 右侧抽屉：设置\n- ライトテーマ/画面の配色を切り替え → 浅色主题/切换画面配色\n- サウンド/操作音を鳴らす → 声音/播放操作音\n- 自動展開/1つ開くと他を閉じる → 自动展开/打开一个即关闭其他\n- すべて閉じる/開いている引き出しを戻す → 全部关闭/把打开的抽屉收回\n- 引き出し式インターフェース → 抽屉式界面\n- description paragraph\n- 木製キャビネット → 木质收纳柜\n- 4 段 → 4 层\n- 書類/Documents → 文件/Documents\n- 契約書・保証書・領収書の三点セット。年度ごとに封筒で仕切ってあります。 → 合同、保修卡、收据三件套，按年度用信封装好分隔\n- 2026 年度 → 2026 年度\n- 要返却 → 需归还\n- 原本 → 原件\n- 工具/Tools → 工具/Tools\n- ドライバー（＋・− 各 3 サイズ） → 螺丝刀（十字・一字 各 3 种规格）\n- メジャー 5m、六角レンチセット → 卷尺 5m、内六角扳手套装\n- 結束バンド、両面テープ、養生テープ → 扎带、双面胶、美纹纸胶带\n- ケーブル/Cables → 线缆/Cables\n- Type-C・Lightning・HDMI・LAN をそれぞれ小分け袋に入れて結束しています。 → Type-C、Lightning、HDMI、LAN 分别装入小袋并捆扎好\n- その他/Misc → 其他/Misc\n- 予備の電池、クリップ、付箋、使わなくなった小物の一時避難所。 → 备用电池、夹子、便利贴，以及闲置小物的临时收容所\n- 使い方 → 使用方法\n- 取っ手をタップで開閉 ・ 外側をタップでサイドドロワーが閉じます ・ 設定で「すべて閉じる」も使えます → 点击把手开合 ・ 点击外侧可关闭侧边抽屉 ・ 设置里也能用「全部关闭」\n- JS comments and toasts:\n  - /* --- トースト --- */ → /* --- 提示条 --- */\n  - /* --- 簡易操作音 --- */ → /* --- 简易操作音 --- */\n  - /* --- サイドドロワー開閉 --- */ → /* --- 侧边抽屉开合 --- */\n  - /* --- ナビ項目 --- */ → /* --- 导航项 --- */\n  - /* --- キャビネットの引き出し --- */ → /* --- 收纳柜抽屉 --- */\n  - /* リサイズ時に開いている引き出しの高さを追従 */ → /* 窗口尺寸变化时跟随已打开抽屉的高度 */\n  - /* --- スイッチ --- */ → /* --- 开关 --- */\n  - /* 初期状態：1段目を開いておく */ → /* 初始状态：默认打开第 1 层 */\n  - toast(a.querySelector('b').textContent + ' を選択しました') → ' 已选择'\n  - toast(item.querySelector('.drawer-label b').textContent + ' を開きました') → ' 已打开'\n  - 'ライトテーマに切り替えました' → '已切换到浅色主题'\n  - 'ダークテーマに戻しました' → '已切回深色主题'\n  - 'サウンドをオン' → '声音已开启'\n  - 'サウンドをオフ' → '声音已关闭'\n  - '自動展開オン' → '自动展开已开启'\n  - '自動展開オフ' → '自动展开已关闭'\n  - 'すべての引き出しを閉じました' → '已关闭全部抽屉'\n  - トースト comment\n  - variable names can stay\n\nNow let me write the file with create_file.\n\nI need to be careful with the font-family to include Chinese fonts.\n\nLet me write it out.🔧 调用工具: create_file\n参数: {"path": "/storage/emulated/0/Download/drawer_ui.html", "content": "<!DOCTYPE html>\\n<html lang=\\"zh-CN\\" data-theme=\\"dark\\">\\n<head>\\n<meta charset=\\"UTF-8\\">\\n<meta name=\\"viewport\\" content=\\"width=device-width, initial-scale=1.0, viewport-fit=cover\\">\\n<meta name=\\"color-scheme\\" content=\\"dark light\\">\\n<meta name=\\"theme-color\\" content=\\"#0e1117\\">\\n<title>抽屉式界面 ｜ Drawer UI</title>\\n<style>\\n  :root{\\n    --bg:#0e1117;\\n    --g1:#1a2334;\\n    --g2:#241c36;\\n    --panel:#161b24;\\n    --panel-2:#1d2431;\\n    --line:#2a3344;\\n    --text:#e9eef6;\\n    --muted:#8695ad;\\n    --accent:#4f9cff;\\n    --accent-2:#8b6cff;\\n    --ok:#2fd18a;\\n    --wood:#3d2d23;\\n    --wood-dark:#241a14;\\n    --wood-light:#54402f;\\n    --handle:#d0a771;\\n    --handle-dk:#a67c4c;\\n    --shadow:0 18px 40px rgba(0,0,0,.45);\\n    --ease:cubic-bezier(.22,1,.36,1);\\n    --r:18px;\\n  }\\n  html[data-theme=\\"light\\"]{\\n    --bg:#f2f5fa;\\n    --g1:#dde7f7;\\n    --g2:#ece4f8;\\n    --panel:#ffffff;\\n    --panel-2:#f4f7fc;\\n    --line:#dde4ef;\\n    --text:#131922;\\n    --muted:#5f6d82;\\n    --shadow:0 18px 40px rgba(30,45,70,.16);\\n  }\\n  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}\\n  html,body{height:100%;}\\n  body{\\n    margin:0;\\n    font-family:\\"Noto Sans SC\\",\\"PingFang SC\\",\\"Hiragino Sans GB\\",\\"Microsoft YaHei\\",system-ui,-apple-system,sans-serif;\\n    color:var(--text);\\n    background:\\n      radial-gradient(1100px 560px at 8% -12%, var(--g1) 0%, transparent 62%),\\n      radial-gradient(900px 520px at 108% 6%, var(--g2) 0%, transparent 58%),\\n      var(--bg);\\n    min-height:100dvh;\\n    overflow-x:hidden;\\n    -webkit-font-smoothing:antialiased;\\n    transition:background .35s ease,color .35s ease;\\n  }\\n\\n  /* ============ 顶栏 ============ */\\n  .topbar{\\n    position:sticky;top:0;z-index:40;\\n    display:flex;align-items:center;gap:10px;\\n    padding:13px 15px;\\n    background:color-mix(in srgb,var(--bg) 78%,transparent);\\n    backdrop-filter:blur(16px) saturate(150%);\\n    -webkit-backdrop-filter:blur(16px) saturate(150%);\\n    border-bottom:1px solid color-mix(in srgb,var(--line) 70%,transparent);\\n  }\\n  .icon-btn{\\n    width:42px;height:42px;flex:0 0 auto;display:grid;place-items:center;\\n    border-radius:13px;border:1px solid var(--line);\\n    background:linear-gradient(180deg,var(--panel-2),var(--panel));\\n    color:var(--text);cursor:pointer;padding:0;\\n    transition:transform .18s var(--ease),background .18s,border-color .18s;\\n  }\\n  .icon-btn:active{transform:scale(.9);}\\n  .icon-btn svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;}\\n  .brand{display:flex;flex-direction:column;line-height:1.18;margin-left:2px;flex:1;min-width:0;}\\n  .brand b{font-size:15.5px;letter-spacing:.02em;}\\n  .brand span{font-size:10.5px;color:var(--muted);letter-spacing:.16em;text-transform:uppercase;}\\n\\n  /* ============ 背景遮罩 ============ */\\n  .backdrop{\\n    position:fixed;inset:0;z-index:50;\\n    background:rgba(6,9,14,.58);\\n    backdrop-filter:blur(3px);\\n    -webkit-backdrop-filter:blur(3px);\\n    opacity:0;visibility:hidden;\\n    transition:opacity .34s var(--ease),visibility .34s;\\n  }\\n  .backdrop.show{opacity:1;visibility:visible;}\\n\\n  /* ============ 侧边抽屉 ============ */\\n  .drawer-panel{\\n    position:fixed;top:0;bottom:0;z-index:60;\\n    width:min(78vw,305px);\\n    display:flex;flex-direction:column;\\n    background:linear-gradient(180deg,var(--panel-2),var(--panel));\\n    box-shadow:var(--shadow);\\n    transition:transform .38s var(--ease);\\n    will-change:transform;\\n    padding-top:env(safe-area-inset-top);\\n    overflow-y:auto;\\n  }\\n  .drawer-panel.left{left:0;border-radius:0 var(--r) var(--r) 0;transform:translateX(-102%);border-right:1px solid var(--line);}\\n  .drawer-panel.right{right:0;border-radius:var(--r) 0 0 var(--r);transform:translateX(102%);border-left:1px solid var(--line);}\\n  .drawer-panel.left.open,.drawer-panel.right.open{transform:translateX(0);}\\n\\n  .panel-head{\\n    display:flex;align-items:center;justify-content:space-between;\\n    padding:16px 16px 12px;\\n    border-bottom:1px solid var(--line);\\n  }\\n  .panel-head h3{margin:0;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:600;}\\n  .panel-close{\\n    width:32px;height:32px;border-radius:10px;border:1px solid var(--line);\\n    background:transparent;color:var(--muted);cursor:pointer;display:grid;place-items:center;padding:0;\\n    transition:background .18s,color .18s,transform .18s var(--ease);\\n  }\\n  .panel-close:active{transform:scale(.9);background:var(--panel-2);}\\n  .panel-close svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;}\\n\\n  /* 导航项 */\\n  .nav-list{list-style:none;margin:0;padding:10px;display:flex;flex-direction:column;gap:4px;}\\n  .nav-item{\\n    display:flex;align-items:center;gap:13px;\\n    padding:13px 13px;border-radius:13px;cursor:pointer;\\n    color:var(--text);text-decoration:none;font-size:14.5px;\\n    border:1px solid transparent;\\n    transition:background .2s,border-color .2s,transform .16s var(--ease);\\n  }\\n  .nav-item:active{transform:scale(.98);}\\n  .nav-item.active{\\n    background:linear-gradient(90deg,color-mix(in srgb,var(--accent) 22%,transparent),transparent 85%);\\n    border-color:color-mix(in srgb,var(--accent) 38%,transparent);\\n  }\\n  .nav-ico{\\n    width:34px;height:34px;flex:0 0 auto;border-radius:10px;display:grid;place-items:center;\\n    background:var(--panel-2);border:1px solid var(--line);font-size:16px;\\n  }\\n  .nav-item.active .nav-ico{background:color-mix(in srgb,var(--accent) 26%,transparent);border-color:transparent;}\\n  .nav-txt{display:flex;flex-direction:column;line-height:1.25;}\\n  .nav-txt b{font-weight:600;font-size:14.5px;}\\n  .nav-txt small{font-size:11px;color:var(--muted);}\\n\\n  /* 设置行 */\\n  .set-list{list-style:none;margin:0;padding:10px;display:flex;flex-direction:column;gap:2px;}\\n  .set-row{\\n    display:flex;align-items:center;gap:12px;padding:14px 12px;border-radius:13px;\\n    transition:background .2s;\\n  }\\n  .set-row:active{background:var(--panel-2);}\\n  .set-txt{flex:1;display:flex;flex-direction:column;line-height:1.3;}\\n  .set-txt b{font-size:14px;font-weight:600;}\\n  .set-txt small{font-size:11px;color:var(--muted);margin-top:2px;}\\n  .switch{\\n    position:relative;width:48px;height:28px;flex:0 0 auto;border-radius:99px;\\n    background:var(--line);border:none;cursor:pointer;padding:0;\\n    transition:background .26s var(--ease);\\n  }\\n  .switch::after{\\n    content:\\"\\";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;\\n    background:#fff;box-shadow:0 2px 6px rgba(0,0,0,.3);\\n    transition:transform .26s var(--ease);\\n  }\\n  .switch[aria-checked=\\"true\\"]{background:linear-gradient(90deg,var(--accent),var(--accent-2));}\\n  .switch[aria-checked=\\"true\\"]::after{transform:translateX(20px);}\\n\\n  /* ============ 主内容 ============ */\\n  main{padding:16px 15px 64px;max-width:720px;margin:0 auto;}\\n  .hero{\\n    padding:18px;border-radius:var(--r);\\n    background:linear-gradient(150deg,color-mix(in srgb,var(--accent) 16%,var(--panel)),var(--panel) 62%);\\n    border:1px solid var(--line);\\n    margin-bottom:18px;\\n  }\\n  .hero h1{margin:0 0 6px;font-size:20px;letter-spacing:.01em;}\\n  .hero p{margin:0;font-size:13px;color:var(--muted);line-height:1.65;}\\n\\n  /* ============ 木质收纳柜 ============ */\\n  .cabinet{\\n    border-radius:20px;\\n    padding:14px;\\n    background:linear-gradient(180deg,var(--wood-light),var(--wood) 22%,var(--wood-dark) 100%);\\n    border:1px solid rgba(0,0,0,.42);\\n    box-shadow:\\n      inset 0 1px 0 rgba(255,255,255,.14),\\n      inset 0 -2px 0 rgba(0,0,0,.32),\\n      0 22px 46px rgba(0,0,0,.42);\\n    position:relative;\\n    background-blend-mode:overlay;\\n  }\\n  .cabinet::before{\\n    content:\\"\\";position:absolute;inset:0;border-radius:20px;pointer-events:none;\\n    background:repeating-linear-gradient(92deg,rgba(255,255,255,.032) 0 2px,transparent 2px 7px),\\n               repeating-linear-gradient(88deg,rgba(0,0,0,.06) 0 1px,transparent 1px 9px);\\n    opacity:.9;\\n  }\\n  .cabinet-head{\\n    display:flex;align-items:baseline;justify-content:space-between;\\n    padding:4px 6px 12px;position:relative;\\n  }\\n  .cabinet-head h2{margin:0;font-size:15px;color:#f0dfcb;letter-spacing:.08em;}\\n  .cabinet-head .badge{\\n    font-size:10.5px;padding:3px 9px;border-radius:99px;letter-spacing:.1em;\\n    color:#f5e6d3;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.16);\\n  }\\n\\n  .drawer-item{\\n    position:relative;margin-bottom:9px;border-radius:12px;\\n    transition:margin .4s var(--ease);\\n  }\\n  .drawer-item:last-child{margin-bottom:0;}\\n\\n  .drawer-face{\\n    width:100%;display:flex;align-items:center;gap:12px;\\n    padding:15px 14px;cursor:pointer;text-align:left;\\n    border-radius:12px;border:1px solid rgba(0,0,0,.4);\\n    background:linear-gradient(180deg,var(--wood-light),var(--wood) 55%,var(--wood-dark));\\n    color:#f3e5d4;font-family:inherit;\\n    box-shadow:\\n      inset 0 1px 0 rgba(255,255,255,.2),\\n      inset 0 -3px 0 rgba(0,0,0,.28),\\n      0 6px 12px rgba(0,0,0,.35);\\n    transition:transform .3s var(--ease),box-shadow .3s var(--ease),filter .25s;\\n    position:relative;z-index:2;\\n  }\\n  .drawer-face:active{transform:translateY(1px) scale(.995);filter:brightness(1.06);}\\n  .drawer-item.open .drawer-face{\\n    border-radius:12px 12px 4px 4px;\\n    box-shadow:\\n      inset 0 1px 0 rgba(255,255,255,.24),\\n      0 10px 20px rgba(0,0,0,.42);\\n  }\\n\\n  /* 把手 */\\n  .handle{\\n    width:46px;height:11px;flex:0 0 auto;border-radius:99px;\\n    background:linear-gradient(180deg,var(--handle),var(--handle-dk));\\n    box-shadow:inset 0 1px 0 rgba(255,255,255,.55),0 2px 4px rgba(0,0,0,.45);\\n    position:relative;\\n  }\\n  .handle::before,.handle::after{\\n    content:\\"\\";position:absolute;top:50%;transform:translateY(-50%);\\n    width:6px;height:6px;border-radius:50%;\\n    background:radial-gradient(circle at 35% 30%,#e8cfa9,#8a6537);\\n    box-shadow:inset 0 -1px 1px rgba(0,0,0,.4);\\n  }\\n  .handle::before{left:-3px;}\\n  .handle::after{right:-3px;}\\n\\n  .drawer-label{flex:1;display:flex;flex-direction:column;line-height:1.25;min-width:0;}\\n  .drawer-label b{font-size:14.5px;letter-spacing:.02em;}\\n  .drawer-label small{font-size:10.5px;color:rgba(243,229,212,.62);letter-spacing:.09em;text-transform:uppercase;margin-top:2px;}\\n\\n  .drawer-chev{\\n    width:26px;height:26px;flex:0 0 auto;display:grid;place-items:center;border-radius:8px;\\n    background:rgba(0,0,0,.22);transition:transform .38s var(--ease);\\n  }\\n  .drawer-chev svg{width:14px;height:14px;fill:none;stroke:#e8d7c2;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;}\\n  .drawer-item.open .drawer-chev{transform:rotate(180deg);}\\n\\n  .drawer-body{\\n    overflow:hidden;max-height:0;\\n    transition:max-height .45s var(--ease);\\n    border-radius:0 0 12px 12px;\\n    background:linear-gradient(180deg,#f6efe4,#e8dccb);\\n    box-shadow:inset 0 8px 14px rgba(0,0,0,.24);\\n  }\\n  .drawer-inner{\\n    padding:15px 16px 17px;font-size:13px;line-height:1.75;color:#3b2f24;\\n  }\\n  .drawer-inner p{margin:0 0 9px;}\\n  .drawer-inner p:last-child{margin-bottom:0;}\\n  .drawer-inner ul{margin:0;padding-left:19px;}\\n  .drawer-inner li{margin-bottom:6px;}\\n  .chip{\\n    display:inline-block;font-size:11px;padding:3px 9px;border-radius:99px;margin:0 5px 6px 0;\\n    background:rgba(59,47,36,.09);border:1px solid rgba(59,47,36,.16);color:#4a3b2c;\\n  }\\n\\n  .hint{\\n    margin-top:18px;padding:13px 15px;border-radius:14px;\\n    border:1px dashed var(--line);background:color-mix(in srgb,var(--panel) 70%,transparent);\\n    font-size:12.5px;color:var(--muted);line-height:1.7;\\n  }\\n  .hint b{color:var(--text);}\\n\\n  .toast{\\n    position:fixed;left:50%;bottom:26px;transform:translate(-50%,20px);\\n    z-index:90;padding:11px 18px;border-radius:99px;\\n    background:rgba(22,27,36,.95);border:1px solid var(--line);\\n    color:var(--text);font-size:13px;opacity:0;pointer-events:none;\\n    transition:opacity .28s var(--ease),transform .28s var(--ease);\\n    box-shadow:var(--shadow);backdrop-filter:blur(10px);\\n  }\\n  .toast.show{opacity:1;transform:translate(-50%,0);}\\n\\n  @media (prefers-reduced-motion: reduce){\\n    *{transition-duration:.01ms !important;animation-duration:.01ms !important;}\\n  }\\n</style>\\n</head>\\n<body>\\n\\n<header class=\\"topbar\\">\\n  <button class=\\"icon-btn\\" id=\\"btnLeft\\" aria-label=\\"打开菜单\\" aria-expanded=\\"false\\">\\n    <svg viewBox=\\"0 0 24 24\\"><path d=\\"M4 7h16M4 12h11M4 17h16\\"/></svg>\\n  </button>\\n  <div class=\\"brand\\">\\n    <b>抽屉式界面</b>\\n    <span>Drawer Demo</span>\\n  </div>\\n  <button class=\\"icon-btn\\" id=\\"btnRight\\" aria-label=\\"打开设置\\" aria-expanded=\\"false\\">\\n    <svg viewBox=\\"0 0 24 24\\"><circle cx=\\"12\\" cy=\\"12\\" r=\\"3.2\\"/><path d=\\"M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6\\"/></svg>\\n  </button>\\n</header>\\n\\n<div class=\\"backdrop\\" id=\\"backdrop\\"></div>\\n\\n<!-- 左侧抽屉：导航 -->\\n<nav class=\\"drawer-panel left\\" id=\\"panelLeft\\" aria-hidden=\\"true\\">\\n  <div class=\\"panel-head\\">\\n    <h3>菜单</h3>\\n    <button class=\\"panel-close\\" data-close aria-label=\\"关闭\\">\\n      <svg viewBox=\\"0 0 24 24\\"><path d=\\"M6 6l12 12M18 6L6 18\\"/></svg>\\n    </button>\\n  </div>\\n  <ul class=\\"nav-list\\">\\n    <li><a class=\\"nav-item active\\" href=\\"#\\" data-nav>\\n      <span class=\\"nav-ico\\">🏠</span>\\n      <span class=\\"nav-txt\\"><b>首页</b><small>Home</small></span>\\n    </a></li>\\n    <li><a class=\\"nav-item\\" href=\\"#\\" data-nav>\\n      <span class=\\"nav-ico\\">🗂️</span>\\n      <span class=\\"nav-txt\\"><b>抽屉一览</b><small>Drawers</small></span>\\n    </a></li>\\n    <li><a class=\\"nav-item\\" href=\\"#\\" data-nav>\\n      <span class=\\"nav-ico\\">📊</span>\\n      <span class=\\"nav-txt\\"><b>统计</b><small>Analytics</small></span>\\n    </a></li>\\n    <li><a class=\\"nav-item\\" href=\\"#\\" data-nav>\\n      <span class=\\"nav-ico\\">🔔</span>\\n      <span class=\\"nav-txt\\"><b>通知</b><small>Notifications</small></span>\\n    </a></li>\\n    <li><a class=\\"nav-item\\" href=\\"#\\" data-nav>\\n      <span class=\\"nav-ico\\">⚙️</span>\\n      <span class=\\"nav-txt\\"><b>设置</b><small>Settings</small></span>\\n    </a></li>\\n  </ul>\\n</nav>\\n\\n<!-- 右侧抽屉：设置 -->\\n<aside class=\\"drawer-panel right\\" id=\\"panelRight\\" aria-hidden=\\"true\\">\\n  <div class=\\"panel-head\\">\\n    <h3>设置</h3>\\n    <button class=\\"panel-close\\" data-close aria-label=\\"关闭\\">\\n      <svg viewBox=\\"0 0 24 24\\"><path d=\\"M6 6l12 12M18 6L6 18\\"/></svg>\\n    </button>\\n  </div>\\n  <ul class=\\"set-list\\">\\n    <li class=\\"set-row\\">\\n      <span class=\\"set-txt\\"><b>浅色主题</b><small>切换画面配色</small></span>\\n      <button class=\\"switch\\" role=\\"switch\\" aria-checked=\\"false\\" id=\\"swTheme\\" aria-label=\\"浅色主题\\"></button>\\n    </li>\\n    <li class=\\"set-row\\">\\n      <span class=\\"set-txt\\"><b>声音</b><small>播放操作音</small></span>\\n      <button class=\\"switch\\" role=\\"switch\\" aria-checked=\\"true\\" id=\\"swSound\\" aria-label=\\"声音\\"></button>\\n    </li>\\n    <li class=\\"set-row\\">\\n      <span class=\\"set-txt\\"><b>自动展开</b><small>打开一个即关闭其他</small></span>\\n      <button class=\\"switch\\" role=\\"switch\\" aria-checked=\\"true\\" id=\\"swAuto\\" aria-label=\\"自动展开\\"></button>\\n    </li>\\n    <li class=\\"set-row\\">\\n      <span class=\\"set-txt\\"><b>全部关闭</b><small>把打开的抽屉收回</small></span>\\n      <button class=\\"icon-btn\\" id=\\"btnCloseAll\\" aria-label=\\"全部关闭\\" style=\\"width:38px;height:38px;\\">\\n        <svg viewBox=\\"0 0 24 24\\"><path d=\\"M4 9h16M4 15h16\\"/></svg>\\n      </button>\\n    </li>\\n  </ul>\\n</aside>\\n\\n<main>\\n  <section class=\\"hero\\">\\n    <h1>抽屉式界面</h1>\\n    <p>左侧菜单和右侧设置是侧边抽屉，下方木箱是真正的「抽屉」。按下把手就会向前拉出，露出里面的东西。</p>\\n  </section>\\n\\n  <section class=\\"cabinet\\">\\n    <div class=\\"cabinet-head\\">\\n      <h2>木质收纳柜</h2>\\n      <span class=\\"badge\\">4 层</span>\\n    </div>\\n\\n    <article class=\\"drawer-item\\">\\n      <button class=\\"drawer-face\\" aria-expanded=\\"false\\">\\n        <span class=\\"handle\\" aria-hidden=\\"true\\"></span>\\n        <span class=\\"drawer-label\\"><b>文件</b><small>Documents</small></span>\\n        <span class=\\"drawer-chev\\"><svg viewBox=\\"0 0 24 24\\"><path d=\\"M6 9l6 6 6-6\\"/></svg></span>\\n      </button>\\n      <div class=\\"drawer-body\\">\\n        <div class=\\"drawer-inner\\">\\n          <p>合同、保修卡、收据三件套，按年度用信封装好分隔存放。</p>\\n          <span class=\\"chip\\">2026 年度</span><span class=\\"chip\\">需归还</span><span class=\\"chip\\">原件</span>\\n        </div>\\n      </div>\\n    </article>\\n\\n    <article class=\\"drawer-item\\">\\n      <button class=\\"drawer-face\\" aria-expanded=\\"false\\">\\n        <span class=\\"handle\\" aria-hidden=\\"true\\"></span>\\n        <span class=\\"drawer-label\\"><b>工具</b><small>Tools</small></span>\\n        <span class=\\"drawer-chev\\"><svg viewBox=\\"0 0 24 24\\"><path d=\\"M6 9l6 6 6-6\\"/></svg></span>\\n      </button>\\n      <div class=\\"drawer-body\\">\\n        <div class=\\"drawer-inner\\">\\n          <ul>\\n            <li>螺丝刀（十字・一字 各 3 种规格）</li>\\n            <li>卷尺 5m、内六角扳手套装</li>\\n            <li>扎带、双面胶、美纹纸胶带</li>\\n          </ul>\\n        </div>\\n      </div>\\n    </article>\\n\\n    <article class=\\"drawer-item\\">\\n      <button class=\\"drawer-face\\" aria-expanded=\\"false\\">\\n        <span class=\\"handle\\" aria-hidden=\\"true\\"></span>\\n        <span class=\\"drawer-label\\"><b>线缆</b><small>Cables</small></span>\\n        <span class=\\"drawer-chev\\"><svg viewBox=\\"0 0 24 24\\"><path d=\\"M6 9l6 6 6-6\\"/></svg></span>\\n      </button>\\n      <div class=\\"drawer-body\\">\\n        <div class=\\"drawer-inner\\">\\n          <p>Type-C、Lightning、HDMI、LAN 分别装入小袋并捆扎整齐。</p>\\n          <span class=\\"chip\\">Type-C ×4</span><span class=\\"chip\\">HDMI 2.1</span><span class=\\"chip\\">网线 Cat6</span>\\n        </div>\\n      </div>\\n    </article>\\n\\n    <article class=\\"drawer-item\\">\\n      <button class=\\"drawer-face\\" aria-expanded=\\"false\\">\\n        <span class=\\"handle\\" aria-hidden=\\"true\\"></span>\\n        <span class=\\"drawer-label\\"><b>其他</b><small>Misc</small></span>\\n        <span class=\\"drawer-chev\\"><svg viewBox=\\"0 0 24 24\\"><path d=\\"M6 9l6 6 6-6\\"/></svg></span>\\n      </button>\\n      <div class=\\"drawer-body\\">\\n        <div class=\\"drawer-inner\\">\\n          <p>备用电池、夹子、便利贴，以及闲置小物的临时收容所。</p>\\n        </div>\\n      </div>\\n    </article>\\n  </section>\\n\\n  <div class=\\"hint\\">\\n    <b>使用方法</b><br>\\n    点击把手开合 ・ 点击外侧可关闭侧边抽屉 ・ 设置里也能用「全部关闭」\\n  </div>\\n</main>\\n\\n<div class=\\"toast\\" id=\\"toast\\"></div>\\n\\n<script>\\n(function(){\\n  \\"use strict\\";\\n\\n  var backdrop = document.getElementById('backdrop');\\n  var panelL   = document.getElementById('panelLeft');\\n  var panelR   = document.getElementById('panelRight');\\n  var btnL     = document.getElementById('btnLeft');\\n  var btnR     = document.getElementById('btnRight');\\n  var toastEl  = document.getElementById('toast');\\n  var soundOn  = true;\\n  var autoSolo = true;\\n\\n  /* --- 提示条 --- */\\n  var toastTimer = null;\\n  function toast(msg){\\n    toastEl.textContent = msg;\\n    toastEl.classList.add('show');\\n    clearTimeout(toastTimer);\\n    toastTimer = setTimeout(function(){ toastEl.classList.remove('show'); }, 1600);\\n  }\\n\\n  /* --- 简易操作音 --- */\\n  var actx = null;\\n  function beep(freq){\\n    if(!soundOn) return;\\n    try{\\n      if(!actx) actx = new (window.AudioContext \p\p window.webkitAudioContext)();\\n      var o = actx.createOscillator(), g = actx.createGain();\\n      o.type = 'sine';\\n      o.frequency.value = freq \p\p 660;\\n      g.gain.setValueAtTime(0.0001, actx.currentTime);\\n      g.gain.exponentialRampToValueAtTime(0.06, actx.currentTime + 0.01);\\n      g.gain.exponentialRampToValueAtTime(0.0001, actx.currentTime + 0.14);\\n      o.connect(g); g.connect(actx.destination);\\n      o.start(); o.stop(actx.currentTime + 0.15);\\n    }catch(e){}\\n  }\\n\\n  /* --- 侧边抽屉开合 --- */\\n  function openSide(){\\n    backdrop.classList.add('show');\\n    document.body.style.overflow = 'hidden';\\n  }\\n  function closeAllSides(){\\n    panelL.classList.remove('open');\\n    panelR.classList.remove('open');\\n    backdrop.classList.remove('show');\\n    document.body.style.overflow = '';\\n    btnL.setAttribute('aria-expanded','false');\\n    btnR.setAttribute('aria-expanded','false');\\n    panelL.setAttribute('aria-hidden','true');\\n    panelR.setAttribute('aria-hidden','true');\\n  }\\n  btnL.addEventListener('click', function(){\\n    var willOpen = !panelL.classList.contains('open');\\n    closeAllSides();\\n    if(willOpen){\\n      panelL.classList.add('open');\\n      btnL.setAttribute('aria-expanded','true');\\n      panelL.setAttribute('aria-hidden','false');\\n      openSide();\\n      beep(520);\\n    }\\n  });\\n  btnR.addEventListener('click', function(){\\n    var willOpen = !panelR.classList.contains('open');\\n    closeAllSides();\\n    if(willOpen){\\n      panelR.classList.add('open');\\n      btnR.setAttribute('aria-expanded','true');\\n      panelR.setAttribute('aria-hidden','false');\\n      openSide();\\n      beep(520);\\n    }\\n  });\\n  backdrop.addEventListener('click', closeAllSides);\\n  Array.prototype.forEach.call(document.querySelectorAll('[data-close]'), function(b){\\n    b.addEventListener('click', function(){ closeAllSides(); });\\n  });\\n  document.addEventListener('keydown', function(e){\\n    if(e.key === 'Escape') closeAllSides();\\n  });\\n\\n  /* --- 导航项 --- */\\n  Array.prototype.forEach.call(document.querySelectorAll('[data-nav]'), function(a){\\n    a.addEventListener('click', function(e){\\n      e.preventDefault();\\n      Array.prototype.forEach.call(document.querySelectorAll('[data-nav]'), function(x){\\n        x.classList.remove('active');\\n      });\\n      a.classList.add('active');\\n      beep(700);\\n      toast('已选择 ' + a.querySelector('b').textContent);\\n      setTimeout(closeAllSides, 240);\\n    });\\n  });\\n\\n  /* --- 收纳柜抽屉 --- */\\n  var drawers = Array.prototype.slice.call(document.querySelectorAll('.drawer-item'));\\n\\n  function setOpen(item, open){\\n    var face = item.querySelector('.drawer-face');\\n    var body = item.querySelector('.drawer-body');\\n    item.classList.toggle('open', open);\\n    face.setAttribute('aria-expanded', open ? 'true' : 'false');\\n    body.style.maxHeight = open ? (body.scrollHeight + 'px') : '0px';\\n  }\\n\\n  drawers.forEach(function(item, idx){\\n    var face = item.querySelector('.drawer-face');\\n    face.addEventListener('click', function(){\\n      var willOpen = !item.classList.contains('open');\\n      if(willOpen && autoSolo){\\n        drawers.forEach(function(o){ if(o !== item) setOpen(o, false); });\\n      }\\n      setOpen(item, willOpen);\\n      beep(willOpen ? 440 + idx * 60 : 300);\\n      if(willOpen){\\n        toast('已打开 ' + item.querySelector('.drawer-label b').textContent);\\n      }\\n    });\\n  });\\n\\n  /* 窗口尺寸变化时跟随已打开抽屉的高度 */\\n  window.addEventListener('resize', function(){\\n    drawers.forEach(function(item){\\n      if(item.classList.contains('open')){\\n        var body = item.querySelector('.drawer-body');\\n        body.style.maxHeight = body.scrollHeight + 'px';\\n      }\\n    });\\n  });\\n\\n  /* --- 开关 --- */\\n  function bindSwitch(el, onChange){\\n    el.addEventListener('click', function(){\\n      var on = el.getAttribute('aria-checked') === 'true';\\n      el.setAttribute('aria-checked', on ? 'false' : 'true');\\n      beep(on ? 340 : 620);\\n      if(onChange) onChange(!on);\\n    });\\n  }\\n\\n  var swTheme = document.getElementById('swTheme');\\n  bindSwitch(swTheme, function(on){\\n    document.documentElement.setAttribute('data-theme', on ? 'light' : 'dark');\\n    var meta = document.querySelector('meta[name=\\"theme-color\\"]');\\n    if(meta) meta.setAttribute('content', on ? '#f2f5fa' : '#0e1117');\\n    toast(on ? '已切换到浅色主题' : '已切回深色主题');\\n  });\\n\\n  bindSwitch(document.getElementById('swSound'), function(on){\\n    soundOn = on;\\n    toast(on ? '声音已开启' : '声音已关闭');\\n  });\\n\\n  bindSwitch(document.getElementById('swAuto'), function(on){\\n    autoSolo = on;\\n    toast(on ? '自动展开已开启' : '自动展开已关闭');\\n  });\\n\\n  document.getElementById('btnCloseAll').addEventListener('click', function(){\\n    drawers.forEach(function(o){ setOpen(o, false); });\\n    beep(300);\\n    toast('已关闭全部抽屉');\\n  });\\n\\n  /* 初始状态：默认打开第 1 层 */\\n  window.addEventListener('load', function(){\\n    setTimeout(function(){\\n      if(drawers[0]) setOpen(drawers[0], true);\\n    }, 420);\\n  });\\n})();\\n</script>\\n</body>\\n</html>\\n"}\n结果: ✅ 创建 /storage/emulated/0/Download/drawer_ui.html (24360 字节)\n\nNow verify: check for remaining Japanese, check structure.🔧 调用工具: execute_command\n参数: {"command": "cd /storage/emulated/0/Download && echo \\"=== 日本語（ひらがな・カタカナ）残留 ===\\"; grep -n \\"[ぁ-んァ-ン]\\" drawer_ui.html \p wc -l; grep -n \\"[ぁ-んァ-ン]\\" drawer_ui.html \p head -10; echo \\"=== サイズ ===\\"; wc -c drawer_ui.html"}\n结果: === 日本語（ひらがな・カタカナ）残留 ===\n0\n=== サイズ ===\n24360 drawer_ui.html\n\n\n🔧 调用工具: execute_command\n参数: {"command": "cd /storage/emulated/0/Download && python3 -c \\"\\nimport re\\ns=open('drawer_ui.html',encoding='utf-8').read()\\nprint('div open:',len(re.findall(r'<div\\\\b',s)),' close:',len(re.findall(r'</div>',s)))\\nprint('script open:',len(re.findall(r'<script\\\\b',s)),' close:',len(re.findall(r'</script>',s)))\\nprint('style open:',len(re.findall(r'<style\\\\b',s)),' close:',len(re.findall(r'</style>',s)))\\nprint('html/body closed:', s.rstrip().endswith('</html>'))\\nprint('lang:', re.search(r'<html[^>]*>',s).group())\\nprint('title:', re.search(r'<title>(.*?)</title>',s).group(1))\\n\\""}\n结果: div open: 15  close: 15\nscript open: 1  close: 1\nstyle open: 1  close: 1\nhtml/body closed: True\nlang: <html lang="zh-CN" data-theme="dark">\ntitle: 抽屉式界面 ｜ Drawer UI\n\n\nJapanese fully removed, structure intact. Now let me verify in browser on device and test functionality.\n\nLet me get adb shell and open the file in browser, then screenshot/OCR.🔧 调用工具: execute_command\n参数: {"command": "ADB=\\"$HOME/ddsh/adb_up.sh\\"; bash $ADB 2>&1 \p tail -2; ADB=\\"adb -s 127.0.0.1:5555\\"; $ADB shell settings get system accelerometer_rotation; $ADB shell settings get system user_rotation"}\n结果: ✅ 已连接 127.0.0.1:5555